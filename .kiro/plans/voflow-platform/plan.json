{
  "planName": "voflow-platform",
  "description": "VoFlow Platform 按 yuanxing.html 原型对齐后的 Kiro Spec 拆分计划",
  "sourceDocs": [
    "docs/01-智能口播平台需求文档.md",
    "docs/02-智能口播平台开发技术文档.md",
    "AI_RULES.md",
    "yuanxing.html"
  ],
  "executionStandards": {
    "effectiveFrom": "voflow-assets-compliance",
    "document": "AI_RULES.md",
    "requiredForAllSubsequentSpecs": true,
    "rules": [
      "不得在运行时代码、Worker、API route 或前端业务逻辑中新增硬编码配置、密钥、平台列表、状态文案、错误码、MIME 白名单或大小限制",
      "新增配置必须收口到 src/lib/config.ts 或等价配置模块，生产关键密钥缺失时必须 fail fast",
      "新增 API 必须复用统一鉴权、统一响应、统一 Zod 错误处理和 serializer；公共模块缺失时先补公共模块",
      "同类逻辑第二次出现时必须抽公共函数或公共常量",
      "每个 Checkpoint 必须反馈硬编码检查、公共函数提取情况和验证命令"
    ]
  },
  "batches": [
    {
      "batch": 1,
      "goal": "平台底座与本地模型状态",
      "specs": [
        {
          "featureName": "voflow-foundation",
          "specType": "feature",
          "workflowType": "requirements-first",
          "depends": [],
          "description": "实现项目基础、账号、工作台、项目模型和运行环境"
        },
        {
          "featureName": "voflow-assets-compliance",
          "specType": "feature",
          "workflowType": "requirements-first",
          "depends": ["voflow-foundation"],
          "description": "实现素材上传、对象存储、授权记录和审计日志"
        },
        {
          "featureName": "voflow-workflow-engine",
          "specType": "feature",
          "workflowType": "requirements-first",
          "depends": ["voflow-foundation", "voflow-assets-compliance"],
          "description": "实现异步任务、工作流节点、状态机、失败重试和产物记录"
        },
        {
          "featureName": "voflow-local-model-monitor",
          "specType": "feature",
          "workflowType": "requirements-first",
          "depends": ["voflow-foundation"],
          "description": "实现本地 LLM、ASR、TTS、数字人、FFmpeg 服务配置、状态和健康检查"
        }
      ]
    },
    {
      "batch": 2,
      "goal": "爆款输入、合规文案、声音和数字人资产",
      "specs": [
        {
          "featureName": "voflow-reference-extract",
          "specType": "feature",
          "workflowType": "requirements-first",
          "depends": ["voflow-workflow-engine", "voflow-local-model-monitor"],
          "description": "实现爆款链接导入、平台识别、音视频解析、ASR 转写、钩子节奏卖点提取"
        },
        {
          "featureName": "voflow-reference-url-import",
          "specType": "feature",
          "workflowType": "requirements-first",
          "depends": [
            "voflow-reference-extract",
            "voflow-assets-compliance",
            "voflow-workflow-engine",
            "voflow-local-model-monitor"
          ],
          "description": "基于 yt-dlp 实现公开参考链接 metadata、字幕、授权后音频导入，并复用现有爆款结构分析链路"
        },
        {
          "featureName": "voflow-script-ai",
          "specType": "feature",
          "workflowType": "requirements-first",
          "depends": ["voflow-workflow-engine", "voflow-local-model-monitor"],
          "description": "实现文案输入、ASR 转写、本地大模型文案改写、标题生成和基础风险提示"
        },
        {
          "featureName": "voflow-legal-review",
          "specType": "feature",
          "workflowType": "requirements-first",
          "depends": ["voflow-script-ai"],
          "description": "实现 AI 法务审查、违禁敏感词、夸大宣传、替换建议和人工确认"
        },
        {
          "featureName": "voflow-tts",
          "specType": "feature",
          "workflowType": "requirements-first",
          "depends": ["voflow-workflow-engine", "voflow-assets-compliance"],
          "description": "实现预置音色、TTS 任务、音频产物、试听和确认"
        },
        {
          "featureName": "voflow-voice-clone",
          "specType": "feature",
          "workflowType": "requirements-first",
          "depends": ["voflow-tts", "voflow-assets-compliance"],
          "description": "实现上传声音样本、声音授权、本地训练、克隆音色管理和复用"
        },
        {
          "featureName": "voflow-self-avatar",
          "specType": "feature",
          "workflowType": "requirements-first",
          "depends": ["voflow-assets-compliance"],
          "description": "实现拍照或上传本人照片、照片质检、肖像授权和我的数字人资产"
        }
      ]
    },
    {
      "batch": 3,
      "goal": "成片生成与剪辑包装",
      "specs": [
        {
          "featureName": "voflow-video-render",
          "specType": "feature",
          "workflowType": "requirements-first",
          "depends": ["voflow-tts", "voflow-voice-clone", "voflow-self-avatar", "voflow-workflow-engine"],
          "description": "实现用音频驱动数字人生成口播视频，支持预览和高清"
        },
        {
          "featureName": "voflow-advanced-editing",
          "specType": "feature",
          "workflowType": "requirements-first",
          "depends": ["voflow-video-render", "voflow-assets-compliance"],
          "description": "实现字幕样式、画中画、背景素材、片头片尾、转场和剪辑预览"
        },
        {
          "featureName": "voflow-packaging-export",
          "specType": "feature",
          "workflowType": "requirements-first",
          "depends": ["voflow-legal-review", "voflow-video-render", "voflow-advanced-editing"],
          "description": "实现字幕、BGM、封面、最终 MP4 合成、下载和端到端验收"
        }
      ]
    },
    {
      "batch": 4,
      "goal": "发布辅助与多平台发布",
      "specs": [
        {
          "featureName": "voflow-publish-assistant",
          "specType": "feature",
          "workflowType": "requirements-first",
          "depends": ["voflow-packaging-export"],
          "description": "实现平台发布信息、账号授权、参数检查、一键发布、状态同步和失败重试"
        },
        {
          "featureName": "voflow-real-platform-publish",
          "specType": "feature",
          "workflowType": "requirements-first",
          "depends": ["voflow-publish-assistant", "voflow-packaging-export"],
          "description": "实现首个真实平台 OAuth、真实 Channel Adapter、发布状态同步和最终 MVP 环境复验"
        }
      ]
    }
  ],
  "archiveOnConfirm": []
}
