DATABASE_URL="postgresql://voflow:voflow123@localhost:5432/voflow?schema=public"
REDIS_URL="redis://localhost:6379"
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ACCESS_KEY="voflow"
MINIO_SECRET_KEY="voflow123"
MINIO_BUCKET="voflow"

SESSION_SECRET="your-super-secret-session-key-change-in-production"

# Local AI Model Services
LLM_BASE_URL="http://localhost:8000"
LLM_MODEL="llama3.2"
TTS_BASE_URL="http://localhost:5000"
ASR_BASE_URL="http://localhost:6000"
AVATAR_BASE_URL="http://localhost:7000"
# Avatar photo detector:
# - unavailable: do not call a detector; photo-check returns AVATAR_PHOTO_DETECTOR_UNAVAILABLE
# - mock: local demo fixture detector
# - local: call local_model_services.avatar baseUrl with POST /detect-face
AVATAR_PHOTO_DETECTOR_PROVIDER="unavailable"
# Local /detect-face timeout in milliseconds. Request body:
# { fileName, mimeType, imageBase64, metadata }
# Required response:
# { faceCount, yaw, pitch, roll, blurScore, occlusion, exposure }
AVATAR_PHOTO_DETECTOR_TIMEOUT_MS="5000"
FFMPEG_WORKER="/usr/local/bin/ffmpeg"
GPU_MODE="auto"
QUEUE_REDIS_URL="redis://localhost:6379"
