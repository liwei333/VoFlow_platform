generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  disabled
}

enum TeamRole {
  owner
  admin
  member
}

enum AspectRatio {
  ratio_9_16
  ratio_16_9
  ratio_1_1
}

enum AvatarRenderMode {
  preview
  hd
}

enum AvatarRenderCrop {
  head
  half_body
}

enum EditingPipPosition {
  top_left
  top_right
  bottom_left
  bottom_right
}

enum ProjectStatus {
  active
  archived
}

enum AssetType {
  image
  audio
  video
  subtitle
  bgm
  cover
  avatar_source
  artifact
}

enum LicenseStatus {
  pending
  approved
  rejected
  expired
}

enum AuditAction {
  asset_upload
  asset_update
  asset_delete
  asset_consent
  legal_risk_resolve
  reference_url_import
  job_create
  job_update
}

enum VideoJobStatus {
  pending
  queued
  running
  succeeded
  failed
  cancelled
}

enum WorkflowNodeStatus {
  pending
  queued
  running
  succeeded
  failed
  waiting_approval
  approved
  cancelled
}

enum LocalModelServiceType {
  llm
  asr
  tts
  avatar
  ffmpeg
}

enum LocalModelServiceStatus {
  online
  offline
  busy
  misconfigured
}

enum ScriptSourceType {
  pasted
  asr
  generated
}

enum ScriptStatus {
  draft
  ready
  approved
  archived
}

enum ScriptCandidateStatus {
  draft
  approved
  rejected
}

enum VoiceType {
  preset
  cloned
}

enum VoiceStatus {
  active
  disabled
}

enum TtsRequestStatus {
  queued
  processing
  succeeded
  failed
  waiting_approval
}

enum AvatarStatus {
  draft
  ready
  disabled
  deleted
}

enum LegalReviewStatus {
  pending
  reviewed
  waiting_approval
  approved
}

enum LegalRiskType {
  forbidden
  sensitive
  exaggeration
  copyright
  fact
  platform_rule
}

enum LegalRiskSeverity {
  low
  medium
  high
}

enum LegalRiskAction {
  pending
  replaced
  ignored
  confirmed_safe
}

enum ReferenceSourceType {
  url
  asset
  pasted_text
}

enum ReferenceSourceStatus {
  pending
  parsing
  metadata_ready
  transcribing
  analyzing
  succeeded
  failed
}

enum ReferenceImportMode {
  metadata_only
  subtitle_only
  audio_extract
  uploaded_asset
}

enum ReferenceConsentStatus {
  pending
  confirmed
  rejected
}

model Asset {
  id            String        @id @default(cuid())
  teamId        String
  ownerId       String
  type          AssetType
  name          String
  storageUrl    String
  mimeType      String
  sizeBytes     BigInt
  metadata      Json?
  licenseStatus LicenseStatus @default(pending)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  owner                    User              @relation("AssetOwner", fields: [ownerId], references: [id])
  consents                 AssetConsent[]
  referenceSources         ReferenceSource[]
  sourceAvatars            Avatar[]
  voiceSamples             VoiceSample[]
  editingPipConfigs        EditingConfig[]   @relation("EditingPipAsset")
  editingBackgroundConfigs EditingConfig[]   @relation("EditingBackgroundAsset")

  @@index([teamId, createdAt])
  @@index([teamId, type])
  @@index([teamId, licenseStatus])
  @@map("assets")
}

model AssetConsent {
  id          String   @id @default(cuid())
  assetId     String
  teamId      String
  userId      String
  consentType String
  consentText String
  usageScope  String[]
  ipAddress   String?
  device      Json?
  createdAt   DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([assetId])
  @@index([teamId])
  @@map("asset_consents")
}

model AuditLog {
  id         String      @id @default(cuid())
  teamId     String
  userId     String
  action     AuditAction
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([teamId, createdAt])
  @@index([teamId, action])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

model User {
  id           String     @id @default(cuid())
  email        String?    @unique
  phone        String?    @unique
  passwordHash String
  name         String
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  ownedTeams      Team[]          @relation("TeamOwner")
  teamMemberships TeamMember[]
  ownedProjects   Project[]       @relation("ProjectOwner")
  uploadedAssets  Asset[]         @relation("AssetOwner")
  assetConsents   AssetConsent[]
  auditLogs       AuditLog[]
  videoJobs       VideoJob[]      @relation("VideoJobOwner")
  ownedVoices     Voice[]         @relation("VoiceOwner")
  voiceSamples    VoiceSample[]   @relation("VoiceSampleOwner")
  voiceConsents   VoiceConsent[]
  ownedAvatars    Avatar[]        @relation("AvatarOwner")
  avatarConsents  AvatarConsent[]
  legalReviews    LegalReview[]   @relation("LegalReviewOwner")

  @@map("users")
}

model Team {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner            User              @relation("TeamOwner", fields: [ownerId], references: [id])
  members          TeamMember[]
  projects         Project[]
  videoJobs        VideoJob[]
  referenceSources ReferenceSource[]
  voices           Voice[]
  voiceSamples     VoiceSample[]
  avatars          Avatar[]
  legalReviews     LegalReview[]

  @@map("teams")
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      TeamRole
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

model Project {
  id             String        @id @default(cuid())
  teamId         String
  ownerId        String
  name           String
  targetPlatform String
  aspectRatio    AspectRatio
  status         ProjectStatus @default(active)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  team             Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  owner            User              @relation("ProjectOwner", fields: [ownerId], references: [id])
  videoJobs        VideoJob[]
  scripts          Script[]
  referenceSources ReferenceSource[]

  @@map("projects")
}

model VideoJob {
  id           String         @id @default(cuid())
  projectId    String
  teamId       String
  ownerId      String
  status       VideoJobStatus @default(pending)
  currentNode  String?
  progress     Int            @default(0)
  errorCode    String?
  errorMessage String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  project              Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team                 Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  owner                User                  @relation("VideoJobOwner", fields: [ownerId], references: [id])
  nodes                WorkflowNode[]
  artifacts            Artifact[]
  scripts              Script[]
  ttsRequests          TtsRequest[]
  legalReviews         LegalReview[]
  avatarRenderRequests AvatarRenderRequest[]
  editingConfig        EditingConfig?

  @@index([projectId])
  @@index([teamId, createdAt])
  @@index([status])
  @@map("video_jobs")
}

model WorkflowNode {
  id               String             @id @default(cuid())
  jobId            String
  nodeType         String
  status           WorkflowNodeStatus @default(pending)
  version          Int                @default(1)
  input            Json?
  output           Json?
  error            Json?
  retryCount       Int                @default(0)
  requiresApproval Boolean            @default(false)
  approvedByUserId String?
  approvedAt       DateTime?
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  job                  VideoJob              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  artifacts            Artifact[]
  ttsRequests          TtsRequest[]
  voiceCloneJob        VoiceCloneJob?
  avatarRenderRequests AvatarRenderRequest[]

  @@index([jobId])
  @@index([jobId, nodeType])
  @@index([status])
  @@index([approvedByUserId])
  @@map("workflow_nodes")
}

model Artifact {
  id         String   @id @default(cuid())
  jobId      String
  nodeId     String
  type       String
  storageUrl String
  metadata   Json?
  createdAt  DateTime @default(now())

  job                       VideoJob              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  node                      WorkflowNode          @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  ttsRequests               TtsRequest[]
  avatarRenderAudioRequests AvatarRenderRequest[] @relation("AvatarRenderAudioArtifact")
  editingPreviewConfigs     EditingConfig[]       @relation("EditingPreviewArtifact")

  @@index([jobId])
  @@index([nodeId])
  @@map("artifacts")
}

model EditingConfig {
  id                      String             @id @default(cuid())
  jobId                   String             @unique
  subtitleEnabled         Boolean            @default(true)
  keywordHighlightEnabled Boolean            @default(false)
  bgmDuckingEnabled       Boolean            @default(true)
  pipEnabled              Boolean            @default(false)
  pipAssetId              String?
  pipPosition             EditingPipPosition @default(top_right)
  pipSize                 Int                @default(25)
  backgroundAssetId       String?
  voiceVolume             Int                @default(100)
  bgmVolume               Int                @default(35)
  transitionStrength      Int                @default(50)
  configJson              Json?
  previewArtifactId       String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  job             VideoJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  pipAsset        Asset?    @relation("EditingPipAsset", fields: [pipAssetId], references: [id], onDelete: SetNull)
  backgroundAsset Asset?    @relation("EditingBackgroundAsset", fields: [backgroundAssetId], references: [id], onDelete: SetNull)
  previewArtifact Artifact? @relation("EditingPreviewArtifact", fields: [previewArtifactId], references: [id], onDelete: SetNull)

  @@index([pipAssetId])
  @@index([backgroundAssetId])
  @@index([previewArtifactId])
  @@map("editing_configs")
}

model LocalModelService {
  id          String                  @id @default(cuid())
  serviceType LocalModelServiceType   @unique
  name        String
  baseUrl     String?
  modelName   String?
  status      LocalModelServiceStatus @default(misconfigured)
  latencyMs   Int?
  resource    Json?
  lastError   Json?
  checkedAt   DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([status])
  @@map("local_model_services")
}

model Script {
  id         String           @id @default(cuid())
  projectId  String
  jobId      String?
  sourceType ScriptSourceType
  content    String
  metadata   Json?
  version    Int              @default(1)
  status     ScriptStatus     @default(draft)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  project                    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  job                        VideoJob?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  candidates                 ScriptCandidate[]
  asrSegments                AsrSegment[]
  referenceTranscriptSources ReferenceSource[] @relation("ReferenceTranscript")

  @@index([projectId])
  @@index([jobId])
  @@index([status])
  @@map("scripts")
}

model ReferenceSource {
  id                 String                 @id @default(cuid())
  projectId          String
  teamId             String
  sourceType         ReferenceSourceType
  platform           String?
  sourceUrl          String?
  assetId            String?
  status             ReferenceSourceStatus  @default(pending)
  durationMs         Int?
  transcriptScriptId String?
  title              String?
  thumbnailUrl       String?
  metadataJson       Json?
  subtitleJson       Json?
  importMode         ReferenceImportMode?
  consentStatus      ReferenceConsentStatus @default(pending)
  consentConfirmedAt DateTime?
  consentConfirmedBy String?
  structureJson      Json?
  errorJson          Json?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  project          Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team             Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  asset            Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)
  transcriptScript Script? @relation("ReferenceTranscript", fields: [transcriptScriptId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([teamId, createdAt])
  @@index([assetId])
  @@index([transcriptScriptId])
  @@index([status])
  @@map("reference_sources")
}

model ScriptCandidate {
  id              String                @id @default(cuid())
  scriptId        String
  content         String
  titleCandidates Json?
  riskReport      Json?
  modelName       String?
  prompt          Json?
  version         Int                   @default(1)
  status          ScriptCandidateStatus @default(draft)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  script       Script        @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  ttsRequests  TtsRequest[]
  legalReviews LegalReview[]

  @@index([scriptId])
  @@index([status])
  @@map("script_candidates")
}

model LegalReview {
  id                String            @id @default(cuid())
  teamId            String
  ownerId           String
  scriptCandidateId String
  jobId             String?
  status            LegalReviewStatus @default(pending)
  summaryJson       Json?
  reviewedScript    String
  resolvedScript    String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  team            Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  owner           User            @relation("LegalReviewOwner", fields: [ownerId], references: [id])
  scriptCandidate ScriptCandidate @relation(fields: [scriptCandidateId], references: [id], onDelete: Cascade)
  job             VideoJob?       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  riskItems       LegalRiskItem[]

  @@index([teamId, createdAt])
  @@index([scriptCandidateId])
  @@index([jobId])
  @@index([status])
  @@map("legal_reviews")
}

model LegalRiskItem {
  id            String            @id @default(cuid())
  legalReviewId String
  riskType      LegalRiskType
  severity      LegalRiskSeverity
  originalText  String
  reason        String
  suggestion    String?
  action        LegalRiskAction   @default(pending)
  ignoredReason String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  legalReview LegalReview @relation(fields: [legalReviewId], references: [id], onDelete: Cascade)

  @@index([legalReviewId])
  @@index([riskType])
  @@index([severity])
  @@index([action])
  @@map("legal_risk_items")
}

model Voice {
  id            String        @id @default(cuid())
  teamId        String?
  ownerId       String?
  voiceType     VoiceType     @default(preset)
  name          String
  provider      String
  modelId       String
  status        VoiceStatus   @default(active)
  licenseStatus LicenseStatus @default(approved)
  sampleUrl     String?
  gender        String?
  style         String?
  language      String?
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  team        Team?           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  owner       User?           @relation("VoiceOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ttsRequests TtsRequest[]
  cloneJobs   VoiceCloneJob[] @relation("VoiceCloneOutput")

  @@index([teamId, createdAt])
  @@index([teamId, status])
  @@index([voiceType])
  @@index([licenseStatus])
  @@map("voices")
}

model VoiceSample {
  id            String   @id @default(cuid())
  assetId       String
  teamId        String
  ownerId       String
  durationMs    Int?
  qualityReport Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  asset     Asset           @relation(fields: [assetId], references: [id], onDelete: Restrict)
  team      Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  owner     User            @relation("VoiceSampleOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  consents  VoiceConsent[]
  cloneJobs VoiceCloneJob[]

  @@index([teamId, createdAt])
  @@index([assetId])
  @@index([ownerId])
  @@map("voice_samples")
}

model VoiceConsent {
  id            String   @id @default(cuid())
  voiceSampleId String
  teamId        String
  userId        String
  consentText   String
  usageScope    String[]
  ipAddress     String?
  device        Json?
  createdAt     DateTime @default(now())

  voiceSample VoiceSample @relation(fields: [voiceSampleId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([voiceSampleId])
  @@index([teamId])
  @@index([userId])
  @@map("voice_consents")
}

model VoiceCloneJob {
  id             String             @id @default(cuid())
  workflowNodeId String             @unique
  voiceSampleId  String
  provider       String
  status         WorkflowNodeStatus @default(queued)
  outputVoiceId  String?
  errorJson      Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  workflowNode WorkflowNode @relation(fields: [workflowNodeId], references: [id], onDelete: Cascade)
  voiceSample  VoiceSample  @relation(fields: [voiceSampleId], references: [id], onDelete: Cascade)
  outputVoice  Voice?       @relation("VoiceCloneOutput", fields: [outputVoiceId], references: [id], onDelete: SetNull)

  @@index([voiceSampleId])
  @@index([outputVoiceId])
  @@index([status])
  @@map("voice_clone_jobs")
}

model TtsRequest {
  id                String           @id @default(cuid())
  jobId             String
  nodeId            String?
  voiceId           String
  scriptCandidateId String
  speed             Float            @default(1.0)
  pitch             Float            @default(0)
  pauseJson         Json?
  provider          String
  providerRequestId String?
  status            TtsRequestStatus @default(queued)
  audioArtifactId   String?
  errorJson         Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  job             VideoJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  node            WorkflowNode?   @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  voice           Voice           @relation(fields: [voiceId], references: [id])
  scriptCandidate ScriptCandidate @relation(fields: [scriptCandidateId], references: [id], onDelete: Cascade)
  audioArtifact   Artifact?       @relation(fields: [audioArtifactId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([nodeId])
  @@index([voiceId])
  @@index([scriptCandidateId])
  @@index([status])
  @@map("tts_requests")
}

model AvatarRenderRequest {
  id                String           @id @default(cuid())
  jobId             String
  nodeId            String
  avatarId          String
  audioArtifactId   String
  mode              AvatarRenderMode
  aspectRatio       AspectRatio
  crop              AvatarRenderCrop
  provider          String
  providerRequestId String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  job           VideoJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  node          WorkflowNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  avatar        Avatar       @relation(fields: [avatarId], references: [id], onDelete: Restrict)
  audioArtifact Artifact     @relation("AvatarRenderAudioArtifact", fields: [audioArtifactId], references: [id], onDelete: Restrict)

  @@index([jobId, createdAt])
  @@index([nodeId])
  @@index([avatarId])
  @@index([audioArtifactId])
  @@map("avatar_render_requests")
}

model Avatar {
  id            String        @id @default(cuid())
  teamId        String
  ownerId       String
  name          String
  sourceAssetId String
  provider      String?
  status        AvatarStatus  @default(draft)
  licenseStatus LicenseStatus @default(pending)
  qualityReport Json?
  previewUrl    String?
  metadata      Json?
  isDefault     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  team           Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  owner          User                  @relation("AvatarOwner", fields: [ownerId], references: [id])
  sourceAsset    Asset                 @relation(fields: [sourceAssetId], references: [id], onDelete: Restrict)
  consents       AvatarConsent[]
  renderRequests AvatarRenderRequest[]

  @@index([teamId, createdAt])
  @@index([teamId, status])
  @@index([teamId, isDefault])
  @@index([sourceAssetId])
  @@index([licenseStatus])
  @@map("avatars")
}

model AvatarConsent {
  id          String   @id @default(cuid())
  avatarId    String
  teamId      String
  userId      String
  consentType String
  consentText String
  usageScope  String[]
  ipAddress   String?
  device      Json?
  createdAt   DateTime @default(now())

  avatar Avatar @relation(fields: [avatarId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([avatarId])
  @@index([teamId])
  @@map("avatar_consents")
}

model AsrSegment {
  id        String   @id @default(cuid())
  scriptId  String
  startMs   Int
  endMs     Int
  text      String
  createdAt DateTime @default(now())

  script Script @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  @@index([scriptId])
  @@index([scriptId, startMs])
  @@map("asr_segments")
}
